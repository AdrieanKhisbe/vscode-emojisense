{
  "name": "emojisense",
  "private": true,
  "displayName": ":emojisense:",
  "description": "Adds suggestions and autocomplete for emoji",
  "version": "0.10.0",
  "publisher": "bierner",
  "icon": "media/icon.png",
  "license": "MIT",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "keywords": [
    "emoji",
    "emojis",
    "emoticon",
    "emoticons"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "repository": {
    "url": "https://github.com/mattbierner/vscode-emojisense.git"
  },
  "bugs": {
    "url": "https://github.com/mattbierner/vscode-emojisense/issues"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension",
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "emojisense.copyPickerSelection",
        "title": "Copy selected emoji / :shortcode:",
        "category": "Emojisense",
        "enablement": "emojisense.pickerOpen"
      },
      {
        "command": "emojisense.togglePickerInsertionMode",
        "title": "Toggle emoji / :shortcode: insertion",
        "category": "Emojisense",
        "enablement": "emojisense.pickerOpen"
      },
      {
        "command": "emojisense.quickEmoji",
        "title": "Pick an emoji and insert in editor",
        "category": "Emojisense"
      },
      {
        "command": "emojisense.quickEmojitext",
        "title": "Pick an :emoji: and insert in editor",
        "category": "Emojisense"
      },
      {
        "command": "emojisense.quickEmojiTerminal",
        "title": "Pick an emoji and insert in terminal",
        "category": "Emojisense"
      },
      {
        "command": "emojisense.quickEmojitextTerminal",
        "title": "Pick an :emoji: and insert in terminal",
        "category": "Emojisense"
      },
      {
        "command": "emojisense.cyclePickerDescriptionDisplay",
        "title": "Cycle description display",
        "category": "Emojisense",
        "enablement": "emojisense.pickerOpen"
      },
      {
        "command": "emojisense.togglePickerDescriptionSearch",
        "title": "Toggle description and tag search",
        "category": "Emojisense",
        "enablement": "emojisense.pickerOpen"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "emojisense.copyPickerSelection",
          "when": "false"
        },
        {
          "command": "emojisense.togglePickerInsertionMode",
          "when": "false"
        },
        {
          "command": "emojisense.quickEmojiTerminal",
          "when": "panelFocus && activeViewlet == 'workbench.panel.terminal'"
        },
        {
          "command": "emojisense.quickEmojitextTerminal",
          "when": "panelFocus && activeViewlet == 'workbench.panel.terminal'"
        },
        {
          "command": "emojisense.cyclePickerDescriptionDisplay",
          "when": "false"
        },
        {
          "command": "emojisense.togglePickerDescriptionSearch",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "mac": "cmd+c",
        "key": "ctrl+c",
        "command": "emojisense.copyPickerSelection",
        "when": "emojisense.pickerOpen && inQuickOpen"
      },
      {
        "mac": "shift+cmd+i",
        "key": "shift+ctrl+i",
        "linux": "shift+ctrl+alt+i",
        "command": "emojisense.togglePickerInsertionMode",
        "when": "emojisense.pickerOpen && inQuickOpen"
      },
      {
        "mac": "cmd+i",
        "key": "ctrl+i",
        "linux": "ctrl+alt+i",
        "command": "emojisense.quickEmojiTerminal",
        "when": "terminalFocus"
      },
      {
        "mac": "shift+cmd+i",
        "key": "shift+ctrl+i",
        "linux": "shift+ctrl+alt+i",
        "command": "emojisense.quickEmojitextTerminal",
        "when": "terminalFocus"
      },
      {
        "mac": "cmd+i",
        "key": "ctrl+i",
        "linux": "ctrl+alt+i",
        "command": "emojisense.quickEmoji",
        "when": "editorTextFocus"
      },
      {
        "mac": "shift+cmd+i",
        "key": "shift+ctrl+i",
        "linux": "shift+ctrl+alt+i",
        "command": "emojisense.quickEmojitext",
        "when": "editorTextFocus"
      },
      {
        "key": "shift+tab",
        "command": "emojisense.cyclePickerDescriptionDisplay",
        "when": "emojisense.pickerOpen && inQuickInput && quickInputType == 'quickPick' && inputFocus"
      },
      {
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "command": "emojisense.togglePickerDescriptionSearch",
        "when": "emojisense.pickerOpen && inQuickInput && quickInputType == 'quickPick' && inputFocus"
      },
      {
        "key": "tab",
        "command": "emojisense.togglePickerInsertionMode",
        "when": "emojisense.pickerOpen && inQuickInput && quickInputType == 'quickPick' && inputFocus"
      }
    ],
    "configuration": {
      "title": ":emojisense:",
      "properties": {
        "emojisense.picker.ignoreSpaces": {
          "type": "boolean",
          "markdownDescription": "Ignore literal space characters when matching picker input, so `s mile` matches `smile` while the typed spaces remain visible. Tabs and other whitespace characters are not ignored.",
          "default": true
        },
        "emojisense.picker.preferExactMatch": {
          "type": "boolean",
          "markdownDescription": "Prefer exact emoji shortcode matches and automatically focus them in the picker. Accepts names with or without surrounding colons, such as `smile` or `:smile:`. Other fuzzy matches remain available. Native VS Code sorting of shortcode labels can influence the final visible order.",
          "default": true
        },
        "emojisense.picker.preferPrefixMatch": {
          "type": "boolean",
          "markdownDescription": "Prefer emoji shortcodes starting with the input ahead of other fuzzy matches in the supplied picker items. Exact matches take priority when preferExactMatch is enabled. Native VS Code sorting of shortcode labels can influence the final visible order.",
          "default": true
        },
        "emojisense.unicodeCompletionsEnabled": {
          "type": "boolean",
          "markdownDescription": "Enable completions that insert emoji as unicode, i.e. `:smile_cat:` -> 😸",
          "default": true
        },
        "emojisense.markupCompletionsEnabled": {
          "type": "boolean",
          "markdownDescription": "Enable completions that insert emoji markup, i.e. `::smile_cat` -> `:smile_cat:`",
          "default": true
        },
        "emojisense.showOnColon": {
          "type": "boolean",
          "description": "Should emoji completions automatically be shown when you type a colon?",
          "default": true
        },
        "emojisense.emojiDecoratorsEnabled": {
          "type": "boolean",
          "description": "Enables or disables emoji decorators for emoji markup.",
          "default": true
        },
        "emojisense.languages": {
          "type": "object",
          "description": "Controls which languages emojisense is active in. You can also customize emojisense settings per language.\nTo enable emojisense for all languages, use \"*\": true",
          "default": {
            "markdown": true,
            "plaintext": {
              "markupCompletionsEnabled": false,
              "emojiDecoratorsEnabled": false
            },
            "scminput": true,
            "git-commit": true
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "unicodeCompletionsEnabled": {
                    "type": "boolean",
                    "markdownDescription": "Enable completions that insert emoji as unicode, i.e. `:smile_cat:` -> 😸",
                    "default": false
                  },
                  "markupCompletionsEnabled": {
                    "type": "boolean",
                    "markdownDescription": "Enable completions that insert emoji markdown, i.e. `::smile_cat` -> `:smile_cat:`",
                    "default": false
                  },
                  "emojiDecoratorsEnabled": {
                    "type": "boolean",
                    "description": "Enables or disables emoji decorators for emoji markup.",
                    "default": false
                  }
                }
              }
            ]
          }
        },
        "emojisense.picker.description.search": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Search human-readable emoji descriptions and #tags in both pickers, independently of their display. Emoji and shortcode matching remains enabled. Toggle for the current picker with the search button or Cmd+Shift+D (macOS) / Ctrl+Shift+D (Windows/Linux)."
        },
        "emojisense.picker.description.display": {
          "type": "string",
          "enum": [
            "no",
            "description",
            "detail"
          ],
          "default": "description",
          "enumDescriptions": [
            "Hide descriptions and tags.",
            "Show descriptions and tags beside the shortcode.",
            "Show descriptions and tags below the shortcode."
          ],
          "markdownDescription": "Where to display human-readable emoji descriptions and #tags in both pickers, independently of searching. Cycle no → description → detail with the display button or Shift+Tab in the search input. Changes apply only to the current picker."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test",
    "compile": "webpack --config ./build/webpack.config.js",
    "watch": "webpack --watch --config ./build/webpack.config.js",
    "package": "webpack --mode production --config ./build/webpack.config.js",
    "lint": "eslint -c .eslintrc.js --ext .ts src",
    "vscode:prepublish": "npm run package ; npm run package-web",
    "watch-web": "webpack --watch --config ./build/web-extension.webpack.config.js",
    "package-web": "webpack --mode production --devtool hidden-source-map --config ./build/web-extension.webpack.config.js"
  },
  "devDependencies": {
    "@types/node": "^18",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.42.0",
    "process": "^0.11.10",
    "ts-loader": "^9.2.5",
    "typescript": "^5.1.3",
    "webpack": "^5.52.0",
    "webpack-cli": "^4.8.0"
  },
  "dependencies": {
    "gemoji": "^8.1.0"
  }
}
